# Aptos Testnet Configuration
VITE_APTOS_NETWORK=testnet
VITE_CONTRACT_ADDRESS=0x1

# Aptos Keyless - Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Aptos Keyless - Apple Sign In
VITE_APPLE_CLIENT_ID=

# GitHub OAuth
VITE_GITHUB_CLIENT_ID=

# Optional: IPFS Gateway (for future media support)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
VITE_PINATA_API_KEY=

# Optional: CDN asset URLs (override defaults in src/constants.ts)
# VITE_HERO_VIDEO_URL=
# VITE_LANDING_HERO_VIDEO_URL=
# VITE_LANDING_BG_IMAGE_URL=
# VITE_LANDING_USECASES_VIDEO_URL=
